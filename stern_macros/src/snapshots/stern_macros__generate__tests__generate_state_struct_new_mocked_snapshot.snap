#[doc = concat!(
    "Creates new mocked [`", stringify!(SterrenNachtStates),
    "`] with [`Rc`][::std::rc::Rc] and [`RefCell`][::core::cell::RefCell]"
)]
pub fn new_mocked() -> (SterrenNachtStates<M>, SterrenNachtStateMocks) {
    let nacht_rc = ::std::rc::Rc::new(::core::cell::RefCell::new(Default::default()));
    let state_struct = Self {
        nacht: ::stern::MappedPropertyHandle::new_mapped(
            {
                let mut nacht_rc = ::std::rc::Rc::clone(&nacht_rc);
                move |val| {
                    let mut guard = nacht_rc.borrow_mut();
                    *guard = val;
                }
            },
            { move |val| { M::map_nacht(val) } },
        ),
        _phantom: ::core::marker::PhantomData,
    };
    let mock_struct = SterrenNachtStateMocks {
        nacht: nacht_rc,
    };
    (state_struct, mock_struct)
}
